# Configuracion opcional del docente (variables de entorno de Vite).
# Copie este archivo a `.env` (o `.env.local`) y ajuste los valores.
# IMPORTANTE: en una SPA de Vite las variables se INYECTAN EN EL BUILD.
# Cambiarlas requiere reconstruir/redeployar. Solo se exponen las que empiezan
# con VITE_. No coloque aqui datos sensibles: quedan embebidos en el bundle.

# Tamano de batch para el entrenamiento.
#   - vacio o "full": batch = cantidad de registros (batch gradient descent, por defecto)
#   - un entero positivo (ej. 32): mini-batch de ese tamano
VITE_BATCH_SIZE=full

# Maximo de epocas. Si se omite o queda vacio, se usan 1000.
VITE_MAX_EPOCHS=2000

# Learning rate: si se omite, se usa 0.05.
VITE_LEARNING_RATE=0.05

# Funcion de perdida: MSE por defecto. Para clasificacion binaria con salida
# sigmoid se puede habilitar BCE descomentando la siguiente linea.
# VITE_LOSS=meanSquaredError
# VITE_LOSS=binaryCrossentropy
