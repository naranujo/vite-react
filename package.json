{
  "name": "neural-network-playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Neural Network Playground educativo, client-side, para experimentar con redes neuronales en el navegador con TensorFlow.js.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
